SKIPCHECK;

['Direkte_Kosten_Vertrieb']=if (!Vertrieb@<>'A_Vertrieb_Kostendummy'
                              & !Vertrieb@<>'Vertrieb'
                              & !Produkte@<>'Produkte_Kostendummy'
                              & !Produkte@<>'Produkte'
                          ,    
                            DB( 'ZZ_Kosten', 'Direkte_Kosten_Vertrieb', !Zeit, 'Produkte', !Vertrieb)
                          / DB( 'ZZ_Kosten', 'Direkte_Kosten_Vertrieb', !Zeit, 'Produkte', 'A_Vertrieb_Kostendummy')
                          * DB( 'ZZ_Kosten', 'Direkte_Kosten_Vertrieb', !Zeit, !Produkte, 'A_Vertrieb_Kostendummy')
                          ,
                          STET);


